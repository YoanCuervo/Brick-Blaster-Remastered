{
  "name": "brick-blaster-remastered",
  "version": "1.0.0",
  "private": true,
  "description": "Faithful remake of Brick Blaster (Eclipse, 1999)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @brick-blaster/game",
    "build": "npm run build -w @brick-blaster/game && npm run typecheck -w @brick-blaster/desktop",
    "preview": "npm run preview -w @brick-blaster/game",
    "electron:dev": "npm run build -w @brick-blaster/game && npm run start -w @brick-blaster/desktop",
    "electron:build": "npm run build -w @brick-blaster/game && npm run dist -w @brick-blaster/desktop --",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @brick-blaster/game",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
