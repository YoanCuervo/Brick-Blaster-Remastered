# Copy to the server as /srv/brick-blaster/api.env (chmod 600), never into the repository.
# API_HOST, API_PORT, API_TRUST_PROXY and GAME_DATA_DIR are set by deploy/compose.yaml.

# Shared MySQL of the infra: its container name on the shared network.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=brick_blaster
DB_USER=brick_api
DB_PASSWORD=

# Public origin of the site, https only: email links point there, writes from any other origin are refused.
SITE_URL=https://example.fr

# Brevo transactional key. Sender: a no-reply address on the site's domain, authenticated in
# Brevo (SPF and DKIM). Never a personal address.
BREVO_API_KEY=
MAIL_FROM=no-reply@example.fr
